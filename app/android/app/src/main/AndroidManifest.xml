<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The app talks to Supabase + the backend over the network on every
         screen. Declared explicitly (not relied on via transitive plugin
         manifest-merge) so release networking can't silently break if a plugin
         is removed. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+ runtime notification permission for the daily-stylist push
         (CLAUDE.md §20). Required for FirebaseMessaging.requestPermission() to
         show the OS prompt; harmless when push is unconfigured. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Coarse (city-level) location for the AI Stylist's real local weather
         (CLAUDE.md §2, §20). Requested contextually, used on demand only — never
         continuous tracking; fine precision is deliberately NOT requested. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <application
        android:label="Wear The Mood"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Supabase OAuth (Google) deep-link callback. Must match the
                 redirectTo in auth_repository AND the "Redirect URLs" allowlist
                 in Supabase (Authentication -> URL Configuration). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.fashionos.app" android:host="login-callback"/>
            </intent-filter>
            <!-- Verified HTTPS App Links for referral invites (§24): open
                 https://wearthemood.com/r/<code> directly in the app when it is
                 installed. autoVerify checks /.well-known/assetlinks.json on the
                 host (needs the Play App Signing SHA-256). HTTPS only, scoped to
                 the /r/ path so we never claim unrelated website routes. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="wearthemood.com"/>
                <data android:host="www.wearthemood.com"/>
                <data android:pathPrefix="/r/"/>
            </intent-filter>
        </activity>
        <!-- ML Kit install-time model dependency (local BG §2.1, §8.2). Asks
             Google Play services to fetch the Subject Segmentation model when the
             app is installed, so the first Add Garment does not wait on a
             download. Best-effort by design: the engine still checks availability
             with ModuleInstallClient and falls back to the cloud cutout when the
             model is not ready. NOTE: this value is a comma-separated list — if
             another ML Kit model is ever added, append to it, never replace it
             (`google_mlkit_pose_detection` bundles its model in-app and does not
             appear here). -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />
        <!-- FCM default notification channel (§20) — the channel is created
             natively in MainActivity.createNotificationChannels(). A message with
             no explicit channel lands here instead of a system "Miscellaneous". -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="wtm_updates" />
        <!-- Notification SMALL icon (§20). Without this, FCM falls back to
             `applicationInfo.icon` — the full-colour launcher icon — and Android
             5.0+ draws a small icon from its ALPHA CHANNEL ONLY. An opaque
             square therefore rendered as a solid white blob: the "blank logo"
             users reported. `ic_stat_wtm` is the brand monogram as a white
             silhouette on transparency, generated from the same source art by
             scripts/generate_notification_icon.py.
             Must stay in sync with PushMessage.android_icon on the backend,
             which names this exact resource per message. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_wtm" />
        <!-- The tint Android applies to that silhouette in the shade. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notificationAccent" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
